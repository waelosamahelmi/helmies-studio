# Database (Supabase)
DATABASE_URL="postgresql://USER:PASS@HOST:PORT/DB"

# NextAuth
NEXTAUTH_URL="http://localhost:3003"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Admin seed (scripts/seed-admin.mjs) — only used when running the seed script
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="change-me-min-8-chars"
# ADMIN_NAME="Admin"

# KIE (primary AI provider)
KIE_KEY="your-kie-key"

# Alibaba Cloud (Qwen/Wan direct — secondary provider)
ALIBABA_KEY="your-alibaba-key"
ALIBABA_WORKSPACE_ID="your-workspace-id"

# Stripe
STRIPE_SECRET_KEY="sk_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe recurring subscription price IDs
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_STARTER_YEARLY="price_..."
STRIPE_PRICE_STUDIO="price_..."
STRIPE_PRICE_STUDIO_YEARLY="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."

# LLM Provider (for AI agents/orchestrator)
OPENROUTER_KEY=""
# Chat model slug passed to the LLM provider (src/app/api/agent/chat/route.js)
LLM_MODEL="deepseek/deepseek-v4-flash"
# Vision-capable model slug for image analysis (src/lib/visual-intelligence.js)
VISION_MODEL="deepseek/deepseek-v4-flash"

# Cron secret for automation routes
CRON_SECRET="your-cron-secret"
# Shared secret for inbound generation webhooks; falls back to CRON_SECRET if unset
WEBHOOK_SECRET="your-webhook-secret"

# Public site URL — used for Stripe redirect URLs and the outbound-request allowlist
NEXT_PUBLIC_URL="http://localhost:3003"
# Server-side site URL fallback checked by the same allowlist (src/lib/net-allowlist.js)
APP_URL="http://localhost:3003"