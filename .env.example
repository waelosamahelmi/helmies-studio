# Database (Supabase)
DATABASE_URL="postgresql://USER:PASS@HOST:PORT/DB"

# NextAuth
NEXTAUTH_URL="http://localhost:3003"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Salt for hashing anonymous rate-limit keys (src/lib/rate-limit.js). Falls
# back to NEXTAUTH_SECRET if unset, so it keeps working without this — but
# production should set its own value so rotating NEXTAUTH_SECRET doesn't
# also silently reset every in-flight anonymous rate-limit window.
RATE_LIMIT_SALT="generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Admin seed (scripts/seed-admin.mjs) — only used when running the seed script
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="change-me-min-8-chars"
# ADMIN_NAME="Admin"

# KIE (primary AI provider)
KIE_KEY="your-kie-key"

# Alibaba Cloud (Qwen/Wan direct — secondary provider)
ALIBABA_KEY="your-alibaba-key"
ALIBABA_WORKSPACE_ID="your-workspace-id"

# Stripe
STRIPE_SECRET_KEY="sk_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe recurring subscription price IDs
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_STARTER_YEARLY="price_..."
STRIPE_PRICE_STUDIO="price_..."
STRIPE_PRICE_STUDIO_YEARLY="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."

# LLM Provider (for AI agents/orchestrator)
OPENROUTER_KEY=""
# Chat model slug passed to the LLM provider (src/app/api/agent/chat/route.js)
LLM_MODEL="deepseek/deepseek-v4-flash"
# Vision-capable model slug for image analysis (src/lib/visual-intelligence.js)
VISION_MODEL="deepseek/deepseek-v4-flash"

# Cron secret for automation routes
CRON_SECRET="your-cron-secret"
# Shared secret for inbound generation webhooks; falls back to CRON_SECRET if unset
WEBHOOK_SECRET="your-webhook-secret"

# Public site URL — used for Stripe redirect URLs and the outbound-request allowlist
NEXT_PUBLIC_URL="http://localhost:3003"
# Server-side site URL fallback checked by the same allowlist (src/lib/net-allowlist.js)
APP_URL="http://localhost:3003"

# Object storage backend (src/lib/storage). "local" (default, unset is fine)
# keeps writing/reading public/media + public/uploads on disk — no behavior
# change from before Phase 4B. Set to "s3" to switch to the S3-compatible
# driver (src/lib/storage/s3-driver.js) — requires ALL FIVE required S3_*
# vars below; restart both the app AND the worker (scripts/worker.mjs) after
# switching. NOTE: the S3 driver's live path is UNVERIFIED — it has only
# been exercised against a mocked HTTP layer (tests/unit/storage-s3.test.mjs)
# in this environment, which has no S3-compatible credentials. Do not switch
# STORAGE_DRIVER=s3 in production until it has been verified against a real
# bucket.
# STORAGE_DRIVER="local"
# S3_ENDPOINT="https://s3.your-region.your-provider.com"
# S3_REGION="your-region"
# S3_BUCKET="your-bucket-name"
# S3_ACCESS_KEY_ID="your-access-key-id"
# S3_SECRET_ACCESS_KEY="your-secret-access-key"
# Optional — a public base URL (e.g. a CDN in front of the bucket) used for
# the plain `url` putObject/getObject return instead of a presigned one.
# When unset, that url is a presigned getSignedUrl() instead.
# S3_PUBLIC_BASE_URL="https://cdn.your-domain.com"