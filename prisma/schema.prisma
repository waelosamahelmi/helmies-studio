}

model CmsRevision {
  id        String   @id @default(cuid())
  entryId   String
  content   Json
  createdBy String?
  createdAt DateTime @default(now())
  entry     CmsEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@schema("public")
