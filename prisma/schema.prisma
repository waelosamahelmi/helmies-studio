  @@schema("public")
}

model CreditReservation {
  id           String       @id @default(cuid())
  walletId     String
  amount       Int
  generationId String?
  status       String       @default("active")
  createdAt    DateTime     @default(now())
  expiresAt    DateTime?
  releasedAt   DateTime?
  wallet       CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@schema("public")
}

