generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

model User {
  id            String              @id @default(cuid())
  name          String?
  email         String              @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String              @default("user")
  credits       Int                 @default(100)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  accounts      Account[]
  sessions      Session[]
  subscriptions Subscription[]
  generations   Generation[]
  transactions  CreditTransaction[]
  agentRuns     AgentRun[]
  workflows     Workflow[]
  memories      ProjectMemory[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
  rateLimits    RateLimit[]
  brandKits     BrandKit[]
  canvasDocs    CanvasDocument[]
  assets        Asset[]
  wallet        CreditWallet?
  projects      Project[]
  purchases     TemplatePurchase[]
 
  @@schema("public")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("public")
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  plan                   String    @default("free")
  status                 String    @default("active")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Generation {
  id             String   @id @default(cuid())
  userId         String
  tool           String
  model          String
  prompt         String   @db.Text
  params         Json?
  outputUrl      String?  @db.Text
  status         String   @default("pending")
  creditsUsed    Int      @default(1)
  providerCost   Float?   @default(0)
  error          String?  @db.Text
  requestId      String?
  workflowId     String?
  workflowStepId String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

// ── Durable Generation Job Queue (Phase 4A) ──
// Postgres-backed queue for provider generation calls, replacing in-request
// synchronous submission. Status vocabulary (normative for every later
// task): queued (claimable) -> running (leased by a worker) -> succeeded /
// failed (terminal, credits settled/refunded) or dead (terminal after
// maxAttempts or timeout — credits refunded). See src/lib/job-queue.js.
model GenerationJob {
  id                String    @id @default(cuid())
  generationId      String    @unique
  userId            String
  status            String    @default("queued")   // queued|running|succeeded|failed|dead
  idempotencyKey    String    @unique
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3)
  nextRunAt         DateTime  @default(now())
  leaseUntil        DateTime?
  lockedBy          String?
  providerRequestId String?
  providerName      String?
  endpoint          String?
  payload           Json
  timeoutAt         DateTime
  lastError         String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, nextRunAt])
  @@index([status, leaseUntil])
  @@index([timeoutAt])
  @@index([providerRequestId])
  @@schema("public")
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  type        String
  description String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

// ── AI Agents ──
model AgentRun {
  id               String   @id @default(cuid())
  userId           String
  agentType        String
  task             String   @db.Text
  status           String   @default("pending")
  creditsEstimated Int      @default(0)
  creditsUsed      Int      @default(0)
  steps            Json?
  result           Json?
  error            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

// ── Workflows ──
model Workflow {
  id          String        @id @default(cuid())
  userId      String
  name        String
  description String?
  steps       Json
  status      String        @default("draft")
  isTemplate  Boolean       @default(false)
  isPublic    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs        WorkflowRun[]

  @@schema("public")
}

model WorkflowRun {
  id         String   @id @default(cuid())
  workflowId String
  userId     String
  status     String   @default("pending")
  inputs     Json?
  outputs    Json?
  error      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@schema("public")
}

// ── Project Memory ──
model ProjectMemory {
  id        String   @id @default(cuid())
  userId    String
  type      String
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

// ── Admin: Provider config ──
// Provider API keys are configured via environment variables only
// (src/lib/providers.js reads process.env.KIE_KEY / ALIBABA_KEY /
// OPENROUTER_KEY) — this table never stores a plaintext key (Phase 3 Task 7).
model ProviderConfig {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String
  baseUrl   String?
  isActive  Boolean  @default(true)
  markup    Float    @default(2.5)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

// ── Admin: Model pricing ──
model ModelPricing {
  id                 String    @id @default(cuid())
  modelId            String    @unique
  modelType          String
  providerName       String
  providerModelId    String?
  endpoint           String?
  displayName        String?
  description        String?   @db.Text
  capability         String?
  inputModalities    Json      @default("[]")
  outputModalities   Json      @default("[]")
  inputSchema        Json?
  constraints        Json?
  pricingRules       Json?
  billingUnit        String    @default("fixed")
  currency           String    @default("USD")
  regions            Json      @default("[]")
  sourceUrl          String?   @db.Text
  sourceUpdatedAt    DateTime?
  catalogVersion     String?
  managedBySync      Boolean   @default(false)
  isDeprecated       Boolean   @default(false)
  replacementModelId String?
  sortOrder          Int       @default(0)
  background         String?
  backgroundOverlay  Float?
  textColor          String?   @default("light")
  providerCost       Float
  creditsCost        Int
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([providerName, isActive])
  @@index([capability, isActive])
  @@index([modelType, isActive])
  @@schema("public")
}

// ── Admin: Feature flags ──
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("public")
}

// ── Admin: API Keys (user-facing) ──
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

// ── Security: Audit logs ──
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  ip         String?
  userAgent  String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@schema("public")
}

// ── Security: Rate limiting ──
model RateLimit {
  id          String   @id @default(cuid())
  userId      String
  endpoint    String
  count       Int      @default(1)
  windowStart DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@schema("public")
}

// ── Admin: Refunds ──
model Refund {
  id           String    @id @default(cuid())
  userId       String
  generationId String?
  amount       Int
  reason       String?
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  @@schema("public")
}

// ── Director: Production Pipeline ──
model DirectorPipeline {
  id                String   @id @default(cuid())
  userId            String
  title             String
  type              String   @default("music_video")
  status            String   @default("draft")
  plan              Json?
  brief             Json?
  costEstimate      Json?
  validationResults Json?
  stateMetadata     Json?
  assembledUrl      String?  @db.Text
  assemblyMetadata  Json?
  rerunHistory      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@schema("public")
}

// ── Director: Individual Shot ──
model DirectorShot {
  id          String   @id @default(cuid())
  pipelineId  String
  index       Int
  title       String?
  status      String   @default("draft")
  plan        Json?
  imageResult Json?
  videoResult Json?
  audioResult Json?
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("public")
}

// ── Brand Kits ──
model BrandKit {
  id               String       @id @default(cuid())
  userId           String
  name             String
  description      String?
  website          String?
  primaryColors    Json         @default("[]")
  secondaryColors  Json         @default("[]")
  fonts            Json         @default("[]")
  slogans          Json         @default("[]")
  photographyStyle String?
  toneOfVoice      String?
  avoid            Json         @default("[]")
  visualReferences Json         @default("[]")
  fingerprint      Json?
  enforcement      String       @default("off")
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets           BrandAsset[]

  @@schema("public")
}

model BrandAsset {
  id         String   @id @default(cuid())
  brandKitId String
  assetId    String
  role       String   @default("reference")
  createdAt  DateTime @default(now())
  brandKit   BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([brandKitId, assetId])
  @@schema("public")
}

// ── Canvas Documents ──
model CanvasDocument {
  id        String          @id @default(cuid())
  userId    String
  name      String          @default("Untitled Canvas")
  data      Json
  width     Int             @default(1024)
  height    Int             @default(1024)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions  CanvasVersion[]

  @@schema("public")
}

model CanvasVersion {
  id         String         @id @default(cuid())
  documentId String
  name       String?
  data       Json
  snapshot   String?        @db.Text
  createdAt  DateTime       @default(now())
  document   CanvasDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@schema("public")
}

// ── Asset Library ──
model Asset {
  id               String          @id @default(cuid())
  userId           String
  type             String
  source           String          @default("upload")
  storageKey       String?
  url              String?         @db.Text
  thumbnailUrl     String?         @db.Text
  name             String?
  mimeType         String?
  bytes            Int             @default(0)
  width            Int?
  height           Int?
  duration         Float?
  model            String?
  generationId     String?
  parentAssetId    String?
  metadata         Json?
  analysis         Json?
  isFavorite       Boolean         @default(false)
  isDeleted        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandAssets      BrandAsset[]
  relations        AssetRelation[] @relation("assetFrom")
  inverseRelations AssetRelation[] @relation("assetTo")

  @@schema("public")
}

model AssetRelation {
  id          String   @id @default(cuid())
  fromAssetId String
  toAssetId   String
  type        String   @default("derived")
  createdAt   DateTime @default(now())
  fromAsset   Asset    @relation("assetFrom", fields: [fromAssetId], references: [id], onDelete: Cascade)
  toAsset     Asset    @relation("assetTo", fields: [toAssetId], references: [id], onDelete: Cascade)

  @@unique([fromAssetId, toAssetId])
  @@schema("public")
}

// ── Credit Wallet V2 ──
model CreditWallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  available    Int                 @default(0)
  reserved     Int                 @default(0)
  lifetime     Int                 @default(0)
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger       CreditLedger[]
