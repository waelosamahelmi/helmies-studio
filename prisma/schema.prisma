  @@schema("public")
}

model PromptGuideVersion {
  id        String      @id @default(cuid())
  guideId   String
  version   Int
  content   Json
  createdBy String?
  createdAt DateTime    @default(now())
  guide     PromptGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, version])
  @@schema("public")
}

// Per-generation prompt compilation record (spec §33). Stores every pass
// so generations are reproducible and the Prompt Inspector can replay.
model PromptCompilation {
  id             String   @id @default(cuid())
  generationId   String?
  userId         String?
  modelId        String
  tool           String
  rawPrompt      String   @db.Text
  normalized     Json?
  enrichedCtx    Json?
  expandedPrompt String?  @db.Text
  dialectPrompt  String?  @db.Text
  finalPrompt    String   @db.Text
  negativePrompt String?  @db.Text
  guideId        String?
  guideVersion   Int?
  warnings       Json?
  polishMode     String   @default("off")
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([modelId])
  @@schema("public")
}

// ── Visual Intelligence ──
model VisualAnalysis {
  id          String   @id @default(cuid())
  userId      String?
  assetUrl    String   @db.Text
  caption     String?  @db.Text
  background  String?  @db.Text
  palette     Json?
  regions     Json?
  textRegions Json?
  lighting    Json?
  style       Json?
  provider    String?
  createdAt   DateTime @default(now())

  @@index([assetUrl])
  @@index([userId])
  @@schema("public")
}

// ── Provider Health ──
model ProviderIncident {
  id         String    @id @default(cuid())
  provider   String
  type       String
  status     String    @default("open")
  message    String?   @db.Text
  metadata   Json?
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@schema("public")
}

// ── Projects ──
model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  type           String    @default("percentage")
  value          Float
  eligibility    String    @default("all")
  maxUses        Int?
  maxUsesPerUser Int       @default(1)
  currentUses    Int       @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@schema("public")
}

model SubscriptionPlan {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  price              Int
  credits            Int
  stripePriceId      String?
  stripePriceIdYearly String?
  features           Json     @default("[]")
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@schema("public")
}

model CreditPack {
  id            String   @id @default(cuid())
  name          String
  credits       Int
  price         Int
  stripePriceId String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@schema("public")
}

// ── Template Marketplace ──
model Template {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            String
  description     String?             @db.Text
  thumbnailUrl    String?             @db.Text
  category        String              @default("creative")
  toolType        String              // image, video, director, canvas, cinema, audio, etc.
  pricingModel    String              @default("subscription") // "subscription" or "onetime"
  oneTimePrice    Int?                // in cents
  stripePriceId   String?             // Stripe Price ID for one-time
  config          Json                // Pre-filled tool settings JSON
  isPublished     Boolean             @default(false)
  isFeatured      Boolean             @default(false)
  usageLimit      String              @default("unlimited") // "once", "unlimited"
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  purchases       TemplatePurchase[]
  versions        TemplateVersion[]

  @@index([toolType, isPublished])
  @@index([category])
  @@schema("public")
}

// ── Phase 6: versioned executable template graphs ──
// A TemplateVersion.graph is immutable once created: { steps: [{ id, tool,
// modelId, inputs, dependsOn }], sampleInputs }. src/lib/template-graph.js
// validates its structure (validateGraph/topoSort); src/lib/template-quote.js
// prices it step-by-step from ModelPricing (never from the graph or a
// client request) and gates publishing (canPublish). status starts "draft"
// and only becomes "published" via the publish route once canPublish
// passes; "archived" retires a version without deleting run history that
// references it.
model TemplateVersion {
  id         String   @id @default(cuid())
  templateId String
  version    Int
  graph      Json // { steps: [{ id, tool, modelId, inputs, dependsOn }], sampleInputs }
  status     String   @default("draft") // draft|published|archived
  createdAt  DateTime @default(now())
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, status])
  @@schema("public")
}

// TemplateRun (Phase 6 Task 3): one execution of a published TemplateVersion
// over the Phase 4A durable job queue. No FK to User/Template/TemplateVersion
// — deliberately a standalone, id-addressed table like GenerationJob (see
// that model's comment and tests/integration/setup.mjs's explicit truncate
// list): a run must be queryable/updatable independent of those rows' own
// lifecycle, and src/lib/template-runner.js only ever looks it up by its own
// id or by (userId, status), never via a Prisma relation. stepState is keyed
// by the graph's own step ids: { [stepId]: { status, generationId,
// outputUrl, error } }.
model TemplateRun {
  id           String   @id @default(cuid())
  userId       String
  templateId   String
  versionId    String
  status       String   @default("running") // running|completed|failed|cancelled
  stepState    Json // { [stepId]: { status, generationId, outputUrl, error } }
  totalCredits Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, status])
  @@schema("public")
}

model TemplatePurchase {
  id              String          @id @default(cuid())
  userId          String
  templateId      String
  purchaseType    String          // "subscription_included" | "onetime" | "free"
  stripeSessionId String?         // Stripe checkout session for one-time
  stripePricePaid Int?            // Amount paid in cents
  usageRemaining  Int?            // null=unlimited, 0=exhausted
  totalUses       Int             @default(0)
  purchasedAt     DateTime        @default(now())
  lastUsedAt      DateTime?
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template        Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  usages          TemplateUsage[]

  @@unique([userId, templateId])
  @@index([userId])
  @@schema("public")
}

model TemplateUsage {
  id           String           @id @default(cuid())
  purchaseId   String
  generationId String?          // Links to Generation record
  usedAt       DateTime         @default(now())
  purchase     TemplatePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@schema("public")
}

// ── Stripe Webhook Idempotency ──
model StripeEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  eventType     String
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@schema("public")
}

// ── Security: Anonymous rate limiting (Phase 3 Task 4) ──
// Durable replacement for the in-process anonBuckets Map (src/lib/security.js)
// and the register route's local `attempts` Map. Keyed by a salted hash of
// (ip + endpoint) — raw client IPs are never persisted here (privacy per
// contract §4.4). See src/lib/rate-limit.js for the atomic algorithm.
model AnonRateLimit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@schema("public")
}

// ── Contact form submissions ──
// There is no mail transport in this deployment, so messages are persisted
// and read from the admin panel rather than forwarded. Storing them is the
// difference between a form that works and a form that silently discards.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  userId    String?
  ip        String?
  userAgent String?  @db.Text
  status    String   @default("new") // new | read | replied | spam
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([email])
  @@schema("public")
}
