"use client";

import { useState, useCallback } from "react";
import { motion } from "framer-motion";
import {
  PromptComposer, ModelSelector, GenerateButton, StagedProgress,
} from "./StudioComponents";
import { V2V_MODELS } from "@/lib/models";
import { useAsyncGeneration } from "./useAsyncGeneration";
import { apiFetch } from "@/lib/client-fetch";
import { IconVideo, IconSparkle, IconClose, IconBolt, IconArrowUpRight, IconDownload } from "@/components/Icons";

const EASE = [0.32, 0.72, 0, 1];

const VIDEO_EDIT_IDS = new Set([
  "runway-aleph",
  "runway-extend",
  "veo-3-extend",
  "wan-2.6-v2v",
  "wan-2.6-flash-v2v",
  "wan-2.7-video-edit",
]);

const MODELS = V2V_MODELS.filter((m) => VIDEO_EDIT_IDS.has(m.id)).map((m) => ({
  id: m.id,
  displayName: m.name,
  provider: m.provider,
  speedTier: m.id.includes("flash") ? "fast" : m.id.includes("pro") ? "premium" : "standard",
  credits: 0,
  aspectRatios: m.aspectRatios,
  durations: m.durations,
  isExtend: m.isExtend,
  endpoint: m.endpoint,
}));

export default function VideoEditStudio() {
  const [prompt, setPrompt] = useState("");
  const [model, setModel] = useState(MODELS[0].id);
  const [duration, setDuration] = useState(5);
  const [videoUrl, setVideoUrl] = useState(null);
  const [uploading, setUploading] = useState(false);
  const [uploadError, setUploadError] = useState("");
  const [dragOver, setDragOver] = useState(false);
  const [genStage, setGenStage] = useState("");
  const { loading: generating, result, error, elapsed, submit } = useAsyncGeneration();

  const currentModel = MODELS.find((m) => m.id === model) || MODELS[0];
  const DURATIONS = currentModel.durations || [];
  const supportsDuration = Array.isArray(currentModel.durations) && currentModel.durations.length > 0;

  const handleUpload = useCallback(async (files) => {
    const file = Array.from(files || [])[0];
    if (!file) return;
    setUploading(true);
    setUploadError("");
    try {
      const formData = new FormData();
      formData.append("file", file);
      const res = await apiFetch("/api/upload", { method: "POST", body: formData });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Upload failed");
      if (!data.url) throw new Error("No URL returned from upload");
      setVideoUrl(data.url);
    } catch (e) {
      setUploadError(e.message || "Upload failed");
    } finally {
      setUploading(false);
    }
  }, []);

  const handleDrop = useCallback((e) => {
    e.preventDefault();
    setDragOver(false);
    if (e.dataTransfer?.files?.length) handleUpload(e.dataTransfer.files);
  }, [handleUpload]);

  const handleRemoveVideo = useCallback(() => {
    setVideoUrl(null);
    setUploadError("");
  }, []);

  const handleGenerate = useCallback(() => {
    if (!prompt.trim() || !videoUrl) return;
    setGenStage("preparing");
    submit("v2v", model, {
      endpoint: currentModel.endpoint || model,
      prompt,
      video_url: videoUrl,
      duration: supportsDuration ? duration : undefined,
    });
  }, [prompt, videoUrl, model, duration, supportsDuration, submit, currentModel]);

  return (
    <div className="studio__workspace">
      <div className="studio__workspace-body">
        <aside className="studio__pane studio__pane--left">
          <div className="studio__section">
            <h3 className="studio__section-title">Model</h3>
            <ModelSelector models={MODELS} selected={model} onSelect={setModel} recommended={MODELS[0].id} />
          </div>

          {supportsDuration && (
            <div className="studio__section">
              <h3 className="studio__section-title">Duration</h3>
              <div className="studio__chip-group">
                {DURATIONS.map((d) => (
                  <button
                    key={d}
                    onClick={() => setDuration(d)}
                    className={`studio__chip ${duration === d ? "studio__chip--active" : ""}`}
                  >
                    {d}s
                  </button>
                ))}
              </div>
            </div>
          )}

          <div className="studio__section">
            <h3 className="studio__section-title">Source Video</h3>
            {!videoUrl ? (
              <label
                className={`studio__asset-dropzone ${dragOver ? "studio__asset-dropzone--active" : ""}`}
                onDragOver={(e) => { e.preventDefault(); setDragOver(true); }}
                onDragLeave={() => setDragOver(false)}
                onDrop={handleDrop}
                style={{ cursor: uploading ? "wait" : "pointer" }}
              >
                <input
                  type="file"
                  accept="video/*"
                  onChange={(e) => handleUpload(e.target.files)}
                  hidden
                />
                <IconVideo />
                <span>{uploading ? "Uploading..." : "Upload video or drop here"}</span>
              </label>
            ) : (
              <div className="studio__asset-picker">
                <div className="studio__asset-grid">
                  <div className="studio__asset-thumb">
                    <video src={videoUrl} className="studio__result-video" muted />
                    <button onClick={handleRemoveVideo} className="studio__asset-remove">
                      <IconClose />
                    </button>
                  </div>
                </div>
              </div>
            )}
            {uploadError && <p className="studio__error">{uploadError}</p>}
          </div>
        </aside>

        <main className="studio__pane studio__pane--center">
          {error && <div className="studio__error">{error}</div>}
          {generating ? (
            <StagedProgress
              stage={genStage || "preparing"}
              progress={Math.min(elapsed / 60, 0.95)}
              message="Editing your video..."
            />
          ) : result?.url ? (
            <div className="studio__result">
              <video src={result.url} controls autoPlay loop className="studio__result-video" />
              <div className="studio__result-actions">
                <button className="studio__chip" onClick={handleGenerate}>Retry</button>
                <a href={result.url} download className="studio__chip">
                  Download <IconDownload style={{ width: 12, height: 12 }} />
                </a>
                {result.creditsUsed && (
                  <span className="studio__result-credits">
                    <IconBolt style={{ width: 12, height: 12 }} /> {result.creditsUsed} credits
                  </span>
                )}
              </div>
            </div>
          ) : (
            <div className="studio__idle">
              <IconVideo style={{ width: 64, height: 64, opacity: 0.3 }} />
              <h2>Video Edit Studio</h2>
              <p>Upload a video, describe how to edit it, pick a model.</p>
              <p className="studio__idle-modes">Aleph · Extend · V2V · Video Edit</p>
            </div>
          )}
        </main>
      </div>

      <div className="studio__bottombar">
        <div className="studio__bottombar-inner">
          <PromptComposer
            value={prompt}
            onChange={setPrompt}
            placeholder="Describe how to edit the video..."
          />
          <GenerateButton
            onClick={handleGenerate}
            disabled={!prompt.trim() || !videoUrl}
            generating={generating}
            stage={genStage}
          />
        </div>
      </div>
    </div>
  );
}